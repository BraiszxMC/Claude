{
  "schemaVersion": 1,
  "id": "tvcam",
  "version": "${version}",
  "name": "TVCam",
  "description": "Camaras fijas en una segunda ventana limpia, para retransmitir Minecraft estilo television.",
  "authors": [
    "BraiszxMC"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.braiszx.tvcam.TVCam"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    {
      "config": "tvcam.mixins.json",
      "environment": "client"
    }
  ]
}